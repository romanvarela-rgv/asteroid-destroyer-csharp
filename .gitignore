*.cdxv
*.Sync.gz

# IDE - VS Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# IDE - Rider
.idea/

# Visual Studio Navigation project cache files
*.VC.db
*.VC.opendb

# Visual Studio Built-in Unit Test
TestResults/
*.trxe

# Visual Studio Code Analysis reports
*.CodeAnalysisLog.xml
*.lastcodeanalysissucceeded

# FAKE - F# Fake builds
.fake/

# JetBrains Rider
*.sln.DotSettings.user

