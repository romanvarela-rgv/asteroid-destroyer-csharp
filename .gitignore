## [NuGet]
# Restore packages with 'nuget restore' or 'dotnet restore'
packages/*
!.github/workflows/
# Ignore packages in subdirectories
**/packages/*
# Except for the build folder which contains targets for some NuGet packages
!**/packages/build/
# Standard NuGet/dotnet ignore patterns
*.nuget.props
*.nuget.targets
project.lock.json
project.assets.json

## [Testing]
# MSTest test results
TestResults/
# NUnit test results
nunit-summary.xml
nunit-results.xml

